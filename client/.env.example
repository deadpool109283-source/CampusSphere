# Supabase Authentication (must match the Supabase project used by the backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# CampusSphere Backend API URL
# Default '/api' uses Vite dev proxy to forward to the backend (https://localhost:5000) without self-signed cert issues
VITE_API_URL=/api
